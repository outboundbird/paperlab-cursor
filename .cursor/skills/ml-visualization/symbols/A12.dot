digraph "A12" {
    rankdir = LR;
    bgcolor = "white";
    pad = "0.15";
    margin = "0.05";
    fontname = "Segoe UI,DejaVu Sans,sans-serif";
    fontsize = 10;
    label = "";
    node [fontname="Segoe UI,DejaVu Sans,sans-serif", fontsize=10, style="filled", penwidth=1.0];
    edge [fontname="Segoe UI,DejaVu Sans,sans-serif", fontsize=9, color="#444", penwidth=1.0];

    p [label="p", shape=ellipse, fillcolor="#f8d7da", color="#a23b3b"];
    q [label="q", shape=ellipse, fillcolor="#e9ecef", color="#888"];
    p -> q [label="A12: compare\n(KL)", arrowhead=none];
    
}
