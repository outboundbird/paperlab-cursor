digraph "E5" {
    rankdir = LR;
    bgcolor = "white";
    pad = "0.15";
    margin = "0.05";
    fontname = "Segoe UI,DejaVu Sans,sans-serif";
    fontsize = 10;
    label = "";
    node [fontname="Segoe UI,DejaVu Sans,sans-serif", fontsize=10, style="filled", penwidth=1.0];
    edge [fontname="Segoe UI,DejaVu Sans,sans-serif", fontsize=9, color="#444", penwidth=1.0];

    cond [label=<P(Z | A, X)<BR/><FONT POINT-SIZE="8">E5 conditional</FONT>>,
          shape=ellipse, fillcolor="#f8d7da", color="#a23b3b"];
    A [label="A", shape=box, fillcolor="#d1e7dd", color="#1c5e3c"];
    X [label="X", shape=box, fillcolor="#cfe2ff", color="#0d6efd"];
    A -> cond [label="R1"];
    X -> cond [label="R1"];
    
}
