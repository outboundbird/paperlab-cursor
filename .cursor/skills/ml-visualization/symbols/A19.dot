digraph "A19" {
    rankdir = LR;
    bgcolor = "white";
    pad = "0.15";
    margin = "0.05";
    fontname = "Segoe UI,DejaVu Sans,sans-serif";
    fontsize = 10;
    label = "";
    node [fontname="Segoe UI,DejaVu Sans,sans-serif", fontsize=10, style="filled", penwidth=1.0];
    edge [fontname="Segoe UI,DejaVu Sans,sans-serif", fontsize=9, color="#444", penwidth=1.0];

    a [label="loss", shape=box, fillcolor="#f8d7da", color="#a23b3b"];
    b [label="θ",    shape=box, fillcolor="#e9ecef", color="#495057"];
    a -> b [label="A19: propagate ∇", style=dashed, color="#a23b3b"];
    
}
