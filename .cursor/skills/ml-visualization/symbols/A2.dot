digraph "A2" {
    rankdir = LR;
    bgcolor = "white";
    pad = "0.15";
    margin = "0.05";
    fontname = "Segoe UI,DejaVu Sans,sans-serif";
    fontsize = 10;
    label = "";
    node [fontname="Segoe UI,DejaVu Sans,sans-serif", fontsize=10, style="filled", penwidth=1.0];
    edge [fontname="Segoe UI,DejaVu Sans,sans-serif", fontsize=9, color="#444", penwidth=1.0];

    src [label="𝒟", shape=cylinder, fillcolor="#e9ecef", color="#495057"];
    dst [label=<{ xᵢ }<SUB>i=1..M</SUB>>, shape=box, fillcolor="#e9ecef", color="#495057"];
    src -> dst [label="A2: draw"];
    
}
