digraph "A27" {
    rankdir = LR;
    bgcolor = "white";
    pad = "0.15";
    margin = "0.05";
    fontname = "Segoe UI,DejaVu Sans,sans-serif";
    fontsize = 10;
    label = "";
    node [fontname="Segoe UI,DejaVu Sans,sans-serif", fontsize=10, style="filled", penwidth=1.0];
    edge [fontname="Segoe UI,DejaVu Sans,sans-serif", fontsize=9, color="#444", penwidth=1.0];

    s1 [label="rₜ",   shape=box, fillcolor="#fff3cd", color="#a07a00"];
    s2 [label="rₜ₊₁", shape=box, fillcolor="#fff3cd", color="#a07a00"];
    sk [label=<v<SUB>ψ</SUB>(sₜ₊ₖ)>, shape=box, fillcolor="#e9ecef", color="#495057", style="filled,bold"];
    s1 -> s2;
    s2 -> sk [label="A27: bootstrap"];
    
}
