digraph "A7" {
    rankdir = LR;
    bgcolor = "white";
    pad = "0.15";
    margin = "0.05";
    fontname = "Segoe UI,DejaVu Sans,sans-serif";
    fontsize = 10;
    label = "";
    node [fontname="Segoe UI,DejaVu Sans,sans-serif", fontsize=10, style="filled", penwidth=1.0];
    edge [fontname="Segoe UI,DejaVu Sans,sans-serif", fontsize=9, color="#444", penwidth=1.0];

    x1 [label="x₁", shape=box, fillcolor="#cfe2ff", color="#0d6efd"];
    x2 [label="x₂", shape=box, fillcolor="#cfe2ff", color="#0d6efd"];
    x3 [label="x₃", shape=box, fillcolor="#cfe2ff", color="#0d6efd"];
    agg [label=<<FONT POINT-SIZE="20">Σ</FONT><BR/><FONT POINT-SIZE="8">A7 aggregate</FONT>>,
         shape=circle, fillcolor="#e2e3e5", color="#495057"];
    x1 -> agg;
    x2 -> agg;
    x3 -> agg;
    
}
