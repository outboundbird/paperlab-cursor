digraph "E12" {
    rankdir = LR;
    bgcolor = "white";
    pad = "0.15";
    margin = "0.05";
    fontname = "Segoe UI,DejaVu Sans,sans-serif";
    fontsize = 10;
    label = "";
    node [fontname="Segoe UI,DejaVu Sans,sans-serif", fontsize=10, style="filled", penwidth=1.0];
    edge [fontname="Segoe UI,DejaVu Sans,sans-serif", fontsize=9, color="#444", penwidth=1.0];

    subgraph cluster_loop {
        label = <layer l<BR/><FONT POINT-SIZE="8">E12 / A10 loop frame</FONT>>;
        style = "dashed";
        color = "#888";
        inner [label="...", shape=box, fillcolor="white", color="#888"];
    }
    
}
