digraph "A26" {
    rankdir = LR;
    bgcolor = "white";
    pad = "0.15";
    margin = "0.05";
    fontname = "Segoe UI,DejaVu Sans,sans-serif";
    fontsize = 10;
    label = "";
    node [fontname="Segoe UI,DejaVu Sans,sans-serif", fontsize=10, style="filled", penwidth=1.0];
    edge [fontname="Segoe UI,DejaVu Sans,sans-serif", fontsize=9, color="#444", penwidth=1.0];

    r1 [label="r₁", shape=box, fillcolor="#fff3cd", color="#a07a00"];
    r2 [label="r₂", shape=box, fillcolor="#fff3cd", color="#a07a00"];
    r3 [label="r₃", shape=box, fillcolor="#fff3cd", color="#a07a00"];
    s  [label=<<FONT POINT-SIZE="20">Σ</FONT><BR/><FONT POINT-SIZE="8">A26 accumulate</FONT>>,
        shape=circle, fillcolor="#e2e3e5", color="#495057"];
    r1 -> s;
    r2 -> s;
    r3 -> s;
    
}
