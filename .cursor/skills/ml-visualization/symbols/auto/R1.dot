digraph "R1" {
    rankdir = LR;
    bgcolor = "white";
    pad = "0.15";
    margin = "0.05";
    fontname = "Segoe UI,DejaVu Sans,sans-serif";
    fontsize = 10;
    label = "";
    node [fontname="Segoe UI,DejaVu Sans,sans-serif", fontsize=10, style="filled", penwidth=1.0];
    edge [fontname="Segoe UI,DejaVu Sans,sans-serif", fontsize=9, color="#444", penwidth=1.0];

    cond [label="B", shape=box, fillcolor="#cfe2ff", color="#0d6efd"];
    out  [label="A", shape=ellipse, fillcolor="#f8d7da", color="#a23b3b"];
    cond -> out [label="R1: A | B"];
    
}
