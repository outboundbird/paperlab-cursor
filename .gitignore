# Per-paper source material (PDFs, supplementals, upstream clones)
papers/

# Virtual environments
.venv/
gib/

# Per-machine config
paperlab.config.yaml
.marprc.yml

# Sandbox experiment outputs
sandbox/**/outputs/
sandbox/**/__pycache__/

# Experimenter suite: generated data + run artifacts (code + seed config are tracked)
sandbox/experiments/*/data/
sandbox/experiments/*/run/results/*
!sandbox/experiments/*/run/results/.gitkeep
sandbox/experiments/*/run_log.txt

# local setting
.vscode/
# Ignore sandbox contents, but NOT the experimenter suite's experiments/ tree.
# Negation can't re-include a path whose parent dir is excluded, so exclude
# sandbox/* entries individually and carve out experiments/ before recursing.
sandbox/*
!sandbox/experiments/


# Portable binaries (per-machine, downloaded by setup);
# README documents how to populate the folder, so keep it tracked.
tools/graphviz/*
!tools/graphviz/README.md
tools/__pycache__/
tools/hooks/__pycache__/

# worspace
*code-workspace